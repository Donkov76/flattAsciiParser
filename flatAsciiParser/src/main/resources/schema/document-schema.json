{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flatasciiparser.donkov.de/schema/document-schema.json",
  "title": "Flatfile document output",
  "description": "JSON structure of one output file: all HEAD fields at the root level, followed by HEAD_TEXT, HEAD_ALC and POS. All values are strings, taken over unchanged from the flatfile. Fields may be null or empty if the flatfile field is empty.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "RECID", "OHTRCP", "OHTSND", "OHTDOT", "OHTDOD", "OHTDON", "OHTNRF",
    "OHTDLD", "OHTON", "OHTOND", "OHTDQ", "OHTDQD", "OHTAKN", "OHTUSB",
    "OHTUSBD", "OHTIBY", "OHTVABY", "OHTIIV", "OHTVAIV", "OHTIDP",
    "OHTLN1", "OHTLN2", "OHTLN3", "OHTLN4", "OHTLN5",
    "OHTLS1", "OHTLS2", "OHTLS3", "OHTLS4", "OHTLOR", "OHTLPL", "OHTLLA",
    "OHTISU", "OHTRSU", "OHTVASU", "OHTIPE", "OHTVAPE", "OHTIPR",
    "OHTMWS", "OHTRFW", "OHTFOA", "OHTGES", "OHTZAB", "OHTGPB", "OHTSPB",
    "OHTGSB", "OHTINVTYP", "OHTPDF", "HEAD_TEXT", "HEAD_ALC", "POS"
  ],
  "properties": {
    "RECID": { "const": "HEAD" },
    "OHTRCP": { "$ref": "#/$defs/gln" },
    "OHTSND": { "$ref": "#/$defs/gln" },
    "OHTDOT": { "type": ["string", "null"], "pattern": "^(380|381|83|84)?$" },
    "OHTDOD": { "$ref": "#/$defs/date" },
    "OHTDON": { "type": ["string", "null"], "minLength": 1, "maxLength": 35 },
    "OHTNRF": { "type": ["string", "null"], "pattern": "^[79]?$" },
    "OHTDLD": { "$ref": "#/$defs/date" },
    "OHTON": { "$ref": "#/$defs/char35" },
    "OHTOND": { "$ref": "#/$defs/date" },
    "OHTDQ": { "$ref": "#/$defs/char35" },
    "OHTDQD": { "$ref": "#/$defs/date" },
    "OHTAKN": { "$ref": "#/$defs/char35" },
    "OHTUSB": { "$ref": "#/$defs/char35" },
    "OHTUSBD": { "$ref": "#/$defs/date" },
    "OHTIBY": { "$ref": "#/$defs/gln" },
    "OHTVABY": { "$ref": "#/$defs/char35" },
    "OHTIIV": { "$ref": "#/$defs/gln" },
    "OHTVAIV": { "$ref": "#/$defs/char35" },
    "OHTIDP": { "$ref": "#/$defs/gln" },
    "OHTLN1": { "$ref": "#/$defs/char35" },
    "OHTLN2": { "$ref": "#/$defs/char35" },
    "OHTLN3": { "$ref": "#/$defs/char35" },
    "OHTLN4": { "$ref": "#/$defs/char35" },
    "OHTLN5": { "$ref": "#/$defs/char35" },
    "OHTLS1": { "$ref": "#/$defs/char35" },
    "OHTLS2": { "$ref": "#/$defs/char35" },
    "OHTLS3": { "$ref": "#/$defs/char35" },
    "OHTLS4": { "$ref": "#/$defs/char35" },
    "OHTLOR": { "$ref": "#/$defs/char35" },
    "OHTLPL": { "type": ["string", "null"], "maxLength": 9 },
    "OHTLLA": { "type": ["string", "null"], "pattern": "^([A-Za-z]{2,3})?$" },
    "OHTISU": { "$ref": "#/$defs/gln" },
    "OHTRSU": { "$ref": "#/$defs/char35" },
    "OHTVASU": { "$ref": "#/$defs/char35" },
    "OHTIPE": { "$ref": "#/$defs/gln" },
    "OHTVAPE": { "$ref": "#/$defs/char35" },
    "OHTIPR": { "$ref": "#/$defs/gln" },
    "OHTMWS": { "$ref": "#/$defs/decimal2_2" },
    "OHTRFW": { "type": ["string", "null"], "pattern": "^([A-Z]{3})?$" },
    "OHTFOA": { "$ref": "#/$defs/date" },
    "OHTGES": { "$ref": "#/$defs/decimal11_2" },
    "OHTZAB": { "$ref": "#/$defs/decimal11_2" },
    "OHTGPB": { "$ref": "#/$defs/decimal11_2" },
    "OHTSPB": { "$ref": "#/$defs/decimal11_2" },
    "OHTGSB": { "$ref": "#/$defs/decimal11_2" },
    "OHTINVTYP": { "type": ["string", "null"], "pattern": "^[ST]?$" },
    "OHTPDF": { "type": ["string", "null"], "maxLength": 255 },
    "HEAD_TEXT": { "type": "array", "items": { "$ref": "#/$defs/textRecord" } },
    "HEAD_ALC": { "type": "array", "items": { "$ref": "#/$defs/alcRecord" } },
    "POS": { "type": "array", "items": { "$ref": "#/$defs/posRecord" } }
  },
  "$defs": {
    "char35": { "type": ["string", "null"], "maxLength": 35 },
    "gln": { "type": ["string", "null"], "pattern": "^([0-9]{1,13})?$" },
    "date": { "type": ["string", "null"], "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$" },
    "decimal11_2": { "type": ["string", "null"], "pattern": "^([0-9]{1,11},[0-9]{2}-?)?$" },
    "decimal6_2": { "type": ["string", "null"], "pattern": "^([0-9]{1,6},[0-9]{2}-?)?$" },
    "decimal3_2": { "type": ["string", "null"], "pattern": "^([0-9]{1,3},[0-9]{2}-?)?$" },
    "decimal2_2": { "type": ["string", "null"], "pattern": "^([0-9]{1,2},[0-9]{2}-?)?$" },
    "unit": { "type": ["string", "null"], "maxLength": 3 },
    "textRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["RECID", "OTXTXT1", "OTXTXT2", "OTXTXT3", "OTXTXT4", "OTXTXT5", "OTXLNG"],
      "properties": {
        "RECID": { "const": "TEXT" },
        "OTXTXT1": { "type": ["string", "null"], "maxLength": 70 },
        "OTXTXT2": { "type": ["string", "null"], "maxLength": 70 },
        "OTXTXT3": { "type": ["string", "null"], "maxLength": 70 },
        "OTXTXT4": { "type": ["string", "null"], "maxLength": 70 },
        "OTXTXT5": { "type": ["string", "null"], "maxLength": 70 },
        "OTXLNG": { "type": ["string", "null"], "pattern": "^([A-Za-z]{2,3})?$" }
      }
    },
    "alcRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["RECID", "OZAKZA", "OZAART", "OZAPRO", "OZAPROB", "OZAPROR", "OZAMWS"],
      "properties": {
        "RECID": { "const": "ALC" },
        "OZAKZA": { "type": ["string", "null"], "pattern": "^[AC]?$" },
        "OZAART": { "type": ["string", "null"], "pattern": "^(DI|TD|FC|IN|PC)?$" },
        "OZAPRO": { "$ref": "#/$defs/decimal3_2" },
        "OZAPROB": { "$ref": "#/$defs/decimal11_2" },
        "OZAPROR": { "$ref": "#/$defs/decimal11_2" },
        "OZAMWS": { "$ref": "#/$defs/decimal2_2" }
      }
    },
    "posRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "RECID", "OPOLDF", "OPOEAN", "OPOSA", "OPOZTN", "OPOALT", "OPOBEM",
        "OPOBEE", "OPOMOB", "OPOMOE", "OPOPOB", "OPOGZA", "OPOEIP",
        "OPOEIPE", "OPOEIPB", "OPOMWS", "POS_TEXT", "POS_ALC"
      ],
      "properties": {
        "RECID": { "const": "POS" },
        "OPOLDF": { "type": ["string", "null"], "pattern": "^([0-9]{1,6})?$" },
        "OPOEAN": { "type": ["string", "null"], "pattern": "^([0-9A-Za-z]{1,13})?$" },
        "OPOSA": { "$ref": "#/$defs/char35" },
        "OPOZTN": { "$ref": "#/$defs/char35" },
        "OPOALT": { "$ref": "#/$defs/char35" },
        "OPOBEM": { "$ref": "#/$defs/decimal11_2" },
        "OPOBEE": { "$ref": "#/$defs/unit" },
        "OPOMOB": { "$ref": "#/$defs/decimal11_2" },
        "OPOMOE": { "$ref": "#/$defs/unit" },
        "OPOPOB": { "$ref": "#/$defs/decimal11_2" },
        "OPOGZA": { "$ref": "#/$defs/decimal11_2" },
        "OPOEIP": { "$ref": "#/$defs/decimal11_2" },
        "OPOEIPE": { "$ref": "#/$defs/unit" },
        "OPOEIPB": { "$ref": "#/$defs/decimal6_2" },
        "OPOMWS": { "$ref": "#/$defs/decimal2_2" },
        "POS_TEXT": { "type": "array", "items": { "$ref": "#/$defs/textRecord" } },
        "POS_ALC": { "type": "array", "items": { "$ref": "#/$defs/alcRecord" } }
      }
    }
  }
}
